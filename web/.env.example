# ─────────────────────────────────────────────────────────────
# web/.env.example
# Copy this file to web/.env and fill in the values.
# web/.env is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string used by Astro at BUILD TIME to query
# all organisations and filings. Without this variable the build will
# throw immediately ("DATABASE_URL environment variable is required").
# Required.
# How to get the value:
#   Local Docker: use the value below as-is (matches docker-compose.yml defaults).
#   Production: use your hosted Postgres URL.
DATABASE_URL=postgresql://nonprofit:YOUR_PASSWORD@localhost:5433/nonprofit_platform

# The public-facing base URL of the site.
# Used by astro.config.mjs to set Astro's `site` property (which drives
# canonical URL generation) and by sitemap.xml.js for every <loc> entry.
# Optional. Defaults to https://nonprofits.philanthropy.org if not set.
# How to get the value:
#   Local preview: leave unset or set to http://localhost:4321
#   Production: set to your actual domain, e.g. https://nonprofits.philanthropy.org
PUBLIC_SITE_URL=https://nonprofits.philanthropy.org
