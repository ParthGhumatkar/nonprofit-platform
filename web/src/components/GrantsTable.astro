--- 
import { getGrants } from "../lib/db";
import { slugify } from "../lib/seo"; 
interface Props { filingId: number; } 
const { filingId } = Astro.props; 
const rows = await getGrants(filingId); 
const fmt = (v: any) => {
  if (v == null) return '-';
  const n = parseFloat(v);
  if (isNaN(n)) return '-';
  return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(n);
}; 
--- 

<section>
  <h2 class="text-2xl font-semibold tracking-tight text-gray-900 mb-6">Grants Made</h2>
  {rows.length === 0 ? (
    <p class="text-gray-500 text-sm italic">No grants reported in this filing.</p>
  ) : (
    <div class="overflow-x-auto rounded-xl border border-gray-100">
      <table class="w-full text-sm table-fixed">
        <colgroup>
          <col class="w-2/5" />
          <col class="w-2/5" />
          <col class="w-1/5" />
        </colgroup>
        <thead>
          <tr class="border-b-2 border-gray-100 bg-gray-50">
            <th class="py-3 px-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wide">Grantee</th>
            <th class="py-3 px-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wide">Purpose</th>
            <th class="py-3 px-4 text-right text-xs font-semibold text-gray-400 uppercase tracking-wide">Amount</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r, i) => (
            <tr class={`border-b border-gray-100 ${i % 2 === 0 ? 'bg-white' : 'bg-gray-50/60'}`}>
              <td class="py-3 px-4">
                {r.grantee_ein ? (
                  <a href={`/${r.grantee_ein}/${slugify(r.grantee_name || 'Unknown')}`} class="font-semibold text-blue-700 hover:text-blue-900 truncate block" title={r.grantee_name || 'Unknown'}>
                    {r.grantee_name || 'Unknown'}
                  </a>
                ) : (
                  <span class="font-semibold text-gray-900 truncate block" title={r.grantee_name || 'Unknown'}>{r.grantee_name || 'Unknown'}</span>
                )}
              </td>
              <td class="py-3 px-4 text-gray-500 text-sm truncate" title={r.purpose || ''}>{r.purpose || '-'}</td>
              <td class="py-3 px-4 text-right num font-medium text-gray-700 whitespace-nowrap">{fmt(r.amount)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</section>
