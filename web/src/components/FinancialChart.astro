--- 
interface Props {
  filings: any[];
  field: string;
  label: string;
  color: string;
}
const { filings, field, label, color } = Astro.props;
const data = filings
  .filter(f => f.parsed_data?.[field])
  .map(f => ({ year: f.tax_year, value: parseInt(f.parsed_data[field]) || 0 }))
  .reverse();
const latest = data[data.length - 1];
const fmt = (v: number) => new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(v);
const formatted = latest ? fmt(latest.value) : "N/A";
const chartId = "chart-" + field.replace(/[^a-zA-Z0-9]/g, "-");
const yearsStr = data.map(d => d.year).join(",");
const valuesStr = data.map(d => d.value).join(",");
---
<div class="bg-white rounded-2xl shadow-sm p-5 border border-gray-50 flex flex-col min-h-[180px]">
  <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-1">{label}</p>
  <div class="text-2xl font-bold text-gray-900 num" style="font-variant-numeric:tabular-nums">{formatted}</div>
  {data.length > 0 ? (
    <div style="height:110px; margin-top:0.75rem">
      <canvas id={chartId} data-years={yearsStr} data-values={valuesStr} data-label={label} data-color={color}></canvas>
    </div>
  ) : (
    <p class="text-xs text-gray-300 mt-3 italic">No trend data available</p>
  )}
</div>
