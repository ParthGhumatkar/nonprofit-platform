--- 
interface Props { 
  filing: any; 
  ein: string; 
} 
 
const { filing, ein } = Astro.props; 
const d = filing.parsed_data || {}; 
 
const IRS_DETAILS_URL = 'https://apps.irs.gov/app/eos/details';
// ProPublica hosts a PDF rendering for every long-form 990 filing in the IRS
// bulk e-file dataset. Their URL scheme is keyed by EIN + the raw IRS object
// ID (without the "_public" suffix the bulk export appends).
const PROPUBLICA_BASE = 'https://projects.propublica.org/nonprofits/organizations'; 
 
const fmt = (v: any) => {
  if (v == null) return '-';
  const n = parseFloat(v);
  if (isNaN(n)) return '-';
  return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(n);
}; 
 
const pct = (part: any, total: any) => { 
  const p = parseInt(part); 
  const t = parseInt(total); 
  if (isNaN(p) || isNaN(t) || t === 0) return null; 
  return (p / t * 100).toFixed(1) + '%'; 
}; 
 
const rev = parseInt(d.total_revenue) || 0; 
const exp = parseInt(d.total_expenses) || 0; 

const pdfFile = filing.form_type === '990PF'
  ? 'IRS990PF.pdf'
  : filing.form_type === '990EZ'
  ? 'IRS990EZ.pdf'
  : 'IRS990.pdf';
--- 
 
<div class="border border-gray-100 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow duration-200 bg-white" x-data="{ open: false }">

  {/* Header row: year + form badge + chevron */}
  <div class="flex items-center justify-between cursor-pointer select-none" @click="open = !open">
    <div class="flex items-center gap-3">
      <h3 class="font-semibold text-gray-900">Fiscal Year {filing.tax_year}</h3>
      <span class="text-xs font-semibold bg-gray-100 text-gray-600 px-2.5 py-0.5 rounded-full">{filing.form_type}</span>
      {filing.received_date && (
        <span class="text-xs text-gray-400">Received {new Date(filing.received_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
      )}
    </div>
    <button class="flex items-center justify-center w-8 h-8 rounded-full bg-gray-50 hover:bg-gray-100 transition-colors text-gray-500" aria-label="Toggle details">
      <svg x-show="!open" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
      <svg x-show="open" x-cloak xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
      </svg>
    </button>
  </div>

  {/* Summary metric cards */}
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-5">
    <div class="bg-gray-50 rounded-xl p-3">
      <span class="text-xs text-gray-400 font-medium uppercase tracking-wide">Revenue</span>
      <div class="text-base font-semibold text-gray-900 mt-1 num">{fmt(d.total_revenue)}</div>
    </div>
    <div class="bg-gray-50 rounded-xl p-3">
      <span class="text-xs text-gray-400 font-medium uppercase tracking-wide">Expenses</span>
      <div class="text-base font-semibold text-gray-900 mt-1 num">{fmt(d.total_expenses)}</div>
    </div>
    <div class="bg-gray-50 rounded-xl p-3">
      <span class="text-xs text-gray-400 font-medium uppercase tracking-wide">Assets</span>
      <div class="text-base font-semibold text-gray-900 mt-1 num">{fmt(d.total_assets)}</div>
    </div>
    <div class="bg-gray-50 rounded-xl p-3">
      <span class="text-xs text-gray-400 font-medium uppercase tracking-wide">Net Income</span>
      <div class="text-base font-semibold text-gray-900 mt-1 num">{fmt(d.net_income)}</div>
    </div>
  </div>

  {/* Expanded detail */}
  <div x-show="open" x-cloak class="mt-6 pt-6 border-t border-gray-100 space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Notable Sources of Revenue</p>
        <table class="w-full text-sm">
          <tbody>
            {d.contributions && (
              <tr class="odd:bg-white even:bg-gray-50">
                <td class="py-1.5 px-2 text-gray-600 rounded-l">Contributions</td>
                <td class="py-1.5 px-2 text-right num text-gray-800 font-medium">{fmt(d.contributions)}</td>
                <td class="py-1.5 px-2 text-right text-gray-400 w-14 text-xs rounded-r">{pct(d.contributions, d.total_revenue)}</td>
              </tr>
            )}
            {d.prog_revenue && (
              <tr class="odd:bg-white even:bg-gray-50">
                <td class="py-1.5 px-2 text-gray-600 rounded-l">Program Revenue</td>
                <td class="py-1.5 px-2 text-right num text-gray-800 font-medium">{fmt(d.prog_revenue)}</td>
                <td class="py-1.5 px-2 text-right text-gray-400 w-14 text-xs rounded-r">{pct(d.prog_revenue, d.total_revenue)}</td>
              </tr>
            )}
            {d.invest_income && (
              <tr class="odd:bg-white even:bg-gray-50">
                <td class="py-1.5 px-2 text-gray-600 rounded-l">Investment Income</td>
                <td class="py-1.5 px-2 text-right num text-gray-800 font-medium">{fmt(d.invest_income)}</td>
                <td class="py-1.5 px-2 text-right text-gray-400 w-14 text-xs rounded-r">{pct(d.invest_income, d.total_revenue)}</td>
              </tr>
            )}
            {d.other_revenue && (
              <tr class="odd:bg-white even:bg-gray-50">
                <td class="py-1.5 px-2 text-gray-600 rounded-l">Other Revenue</td>
                <td class="py-1.5 px-2 text-right num text-gray-800 font-medium">{fmt(d.other_revenue)}</td>
                <td class="py-1.5 px-2 text-right text-gray-400 w-14 text-xs rounded-r">{pct(d.other_revenue, d.total_revenue)}</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>

      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Notable Expenses</p>
        <table class="w-full text-sm">
          <tbody>
            {d.grants_paid && (
              <tr class="odd:bg-white even:bg-gray-50">
                <td class="py-1.5 px-2 text-gray-600 rounded-l">Grants Paid</td>
                <td class="py-1.5 px-2 text-right num text-gray-800 font-medium">{fmt(d.grants_paid)}</td>
                <td class="py-1.5 px-2 text-right text-gray-400 w-14 text-xs rounded-r">{pct(d.grants_paid, d.total_expenses)}</td>
              </tr>
            )}
            {d.salaries && (
              <tr class="odd:bg-white even:bg-gray-50">
                <td class="py-1.5 px-2 text-gray-600 rounded-l">Salaries & Benefits</td>
                <td class="py-1.5 px-2 text-right num text-gray-800 font-medium">{fmt(d.salaries)}</td>
                <td class="py-1.5 px-2 text-right text-gray-400 w-14 text-xs rounded-r">{pct(d.salaries, d.total_expenses)}</td>
              </tr>
            )}
            {d.fundraising_fees && (
              <tr class="odd:bg-white even:bg-gray-50">
                <td class="py-1.5 px-2 text-gray-600 rounded-l">Fundraising Fees</td>
                <td class="py-1.5 px-2 text-right num text-gray-800 font-medium">{fmt(d.fundraising_fees)}</td>
                <td class="py-1.5 px-2 text-right text-gray-400 w-14 text-xs rounded-r">{pct(d.fundraising_fees, d.total_expenses)}</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>

    {/* Balance Sheet */}
    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Balance Sheet</p>
      <div class="grid grid-cols-3 gap-3 text-sm">
        <div class="bg-blue-50 rounded-xl p-3 border border-blue-100">
          <span class="text-xs text-blue-400 font-medium">Total Assets</span>
          <div class="font-semibold text-gray-900 mt-1 num">{fmt(d.total_assets)}</div>
        </div>
        <div class="bg-orange-50 rounded-xl p-3 border border-orange-100">
          <span class="text-xs text-orange-400 font-medium">Liabilities</span>
          <div class="font-semibold text-gray-900 mt-1 num">{fmt(d.total_liabilities)}</div>
        </div>
        <div class="bg-emerald-50 rounded-xl p-3 border border-emerald-100">
          <span class="text-xs text-emerald-500 font-medium">Net Assets</span>
          <div class="font-semibold text-gray-900 mt-1 num">{fmt(d.net_assets)}</div>
        </div>
      </div>
    </div>

    <div class="pt-2 flex flex-wrap items-center gap-x-4 gap-y-2">
      <a href={`${IRS_DETAILS_URL}?ein=${ein}`} class="inline-flex items-center gap-1 text-sm text-blue-600 hover:text-blue-800 font-medium transition-colors" target="_blank" rel="noopener noreferrer">
        View on IRS.gov ↗
      </a>
      <span class="text-gray-200">|</span>
      <a href={`${PROPUBLICA_BASE}/${ein}/${filing.object_id.replace('_public', '')}/${pdfFile}`} class="inline-flex items-center gap-1 text-sm text-blue-600 hover:text-blue-800 font-medium transition-colors" target="_blank" rel="noopener noreferrer">
        PDF ↓
      </a>
      <span class="text-gray-200">|</span>
      <span class="text-gray-400 text-sm cursor-not-allowed" title="XML download coming soon">XML</span>
    </div>
  </div>

  {/* IRS link shown when collapsed */}
  <div x-show="!open" class="mt-4 pt-3 border-t border-gray-50 flex items-center gap-x-3 gap-y-1 flex-wrap">
    <a href={`${IRS_DETAILS_URL}?ein=${ein}`} class="text-xs text-gray-400 hover:text-blue-600 transition-colors" target="_blank" rel="noopener noreferrer">
      View on IRS.gov ↗
    </a>
    <span class="text-gray-200">|</span>
    <a href={`${PROPUBLICA_BASE}/${ein}/${filing.object_id.replace('_public', '')}/${pdfFile}`} class="text-xs text-gray-400 hover:text-blue-600 transition-colors" target="_blank" rel="noopener noreferrer">
      PDF ↓
    </a>
  </div>
</div>
