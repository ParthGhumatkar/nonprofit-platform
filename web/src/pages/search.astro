---
import BaseLayout from '../layouts/BaseLayout.astro';
const query = (Astro.url.searchParams.get('q') || '').trim();

const POPULAR_SEARCHES = [
  'United Way',
  'Red Cross',
  'Habitat for Humanity',
  'Food Bank',
  'Community Foundation',
  "Children's Hospital",
];
---

<BaseLayout
  title="Search Nonprofits - Philanthropy.org"
  description="Search IRS Form 990 filings for U.S. nonprofit organizations by name or EIN."
>
  <h1 class="text-3xl font-bold tracking-tight text-gray-900 mb-6">Search Nonprofits</h1>

  <form id="search-form" class="mb-3" method="get" action="/search" role="search">
    <div class="flex flex-col sm:flex-row gap-2">
      <div class="relative flex-1 min-w-0">
        <input
          id="search-input"
          type="text"
          name="q"
          value={query}
          placeholder="Organization name or EIN..."
          aria-label="Search nonprofits by name or EIN"
          inputmode="search"
          enterkeyhint="search"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          class="w-full border border-gray-300 rounded-lg pl-4 pr-4 py-2.5 text-base sm:text-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <span
          id="ein-badge"
          hidden
          class="absolute right-2 top-1/2 -translate-y-1/2 text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100 px-2 py-1 rounded-full"
        >Searching by EIN</span>
      </div>
      <select
        id="state-filter"
        aria-label="Filter by state"
        class="border border-gray-300 rounded-lg px-3 py-2.5 text-sm sm:text-base bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 sm:w-44"
      >
        <option value="">All States</option>
      </select>
      <button
        type="submit"
        class="bg-blue-600 text-white px-6 py-2.5 rounded-lg font-medium hover:bg-blue-700 transition-colors sm:w-auto"
      >Search</button>
    </div>
  </form>

  <div id="popular-searches" class="mb-10" aria-label="Popular searches">
    <div class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-2">Try a popular search</div>
    <div class="flex flex-wrap gap-2">
      {POPULAR_SEARCHES.map(term => (
        <button
          type="button"
          data-q={term}
          class="popular-btn text-sm border border-gray-200 bg-gray-50 hover:bg-blue-50 hover:border-blue-200 hover:text-blue-700 text-gray-700 px-3 py-1.5 rounded-full transition-colors"
        >{term}</button>
      ))}
    </div>
  </div>

  <div id="search-status" class="text-center py-12 text-gray-500" aria-live="polite">
    <p class="text-lg">Enter an organization name or EIN to search.</p>
  </div>

  <div id="search-results" class="space-y-3" tabindex="-1"></div>

  <div id="show-more" class="mt-6 text-center" hidden>
    <button
      type="button"
      id="show-more-btn"
      class="inline-flex items-center px-5 py-2.5 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:border-blue-300 hover:text-blue-700 transition-colors"
    >Show next 50</button>
  </div>

  <script>
    const form = document.getElementById('search-form');
    const input = document.getElementById('search-input');
    const stateSelect = document.getElementById('state-filter');
    const status = document.getElementById('search-status');
    const resultsEl = document.getElementById('search-results');
    const showMoreWrap = document.getElementById('show-more');
    const showMoreBtn = document.getElementById('show-more-btn');
    const einBadge = document.getElementById('ein-badge');
    const popularWrap = document.getElementById('popular-searches');

    const PAGE_SIZE = 50;

    let searchIndex = null;
    let indexPromise = null;
    let lastFullResults = [];
    let displayCount = PAGE_SIZE;
    let debounceTimer = null;

    const escapeHtml = (value) => String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

    const formatEin = (ein) => {
      const clean = String(ein || '').replace(/\D/g, '');
      return clean.length === 9 ? `${clean.slice(0, 2)}-${clean.slice(2)}` : ein;
    };

    const slugify = (value) => String(value || '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');

    const formatRevenue = (val) => {
      const n = parseFloat(val);
      if (!val || isNaN(n)) return null;
      if (n >= 1e9) return `$${(n / 1e9).toFixed(1)}B`;
      if (n >= 1e6) return `$${(n / 1e6).toFixed(1)}M`;
      if (n >= 1e3) return `$${(n / 1e3).toFixed(0)}K`;
      return `$${n.toFixed(0)}`;
    };

    const isEinQuery = (query) => query.replace(/\D/g, '').length === 9;

    function showSkeleton() {
      const card = `
        <div class="animate-pulse border border-gray-200 rounded-xl p-4 space-y-2">
          <div class="h-4 bg-gray-200 rounded w-3/4"></div>
          <div class="h-3 bg-gray-200 rounded w-1/2"></div>
        </div>
      `;
      resultsEl.innerHTML = card.repeat(3);
    }

    function populateStateFilter(rows) {
      if (stateSelect.options.length > 1) return;
      const states = [...new Set(rows.map(r => r.state).filter(Boolean))].sort();
      const frag = document.createDocumentFragment();
      for (const s of states) {
        const opt = document.createElement('option');
        opt.value = s;
        opt.textContent = s;
        frag.appendChild(opt);
      }
      stateSelect.appendChild(frag);
    }

    async function loadSearchIndex() {
      if (searchIndex) return searchIndex;
      if (indexPromise) return indexPromise;
      showSkeleton();
      indexPromise = fetch('/search-index.json')
        .then((r) => {
          if (!r.ok) throw new Error(`Search index failed to load: ${r.status}`);
          return r.json();
        })
        .then((data) => {
          searchIndex = data;
          populateStateFilter(data);
          return data;
        })
        .catch((err) => {
          indexPromise = null;
          throw err;
        });
      return indexPromise;
    }

    function searchRows(rows, query, stateFilter) {
      const q = query.trim().toLowerCase();
      const cleanEin = q.replace(/\D/g, '');
      if (!q) return [];

      const exactEin = cleanEin.length === 9
        ? rows.filter((org) => org.ein === cleanEin)
        : [];

      const nameMatches = rows.filter((org) => {
        const name = String(org.canonical_name || '').toLowerCase();
        const ein = String(org.ein || '');
        return name.includes(q) || (cleanEin.length > 2 && ein.includes(cleanEin));
      });

      const seen = new Set();
      return [...exactEin, ...nameMatches].filter((org) => {
        if (seen.has(org.ein)) return false;
        seen.add(org.ein);
        if (stateFilter && org.state !== stateFilter) return false;
        return true;
      });
    }

    function renderCard(org, index) {
      const revenue = formatRevenue(org.total_revenue);
      const filingCount = Number(org.filing_count) || 0;
      const location = org.city && org.state
        ? `${escapeHtml(org.city)}, ${escapeHtml(org.state)}`
        : org.state ? escapeHtml(org.state) : '';

      const categoryBadge = org.ntee_category
        ? `<span class="inline-flex items-center text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100 px-2 py-0.5 rounded-full">${escapeHtml(org.ntee_category)}</span>`
        : '';

      const meta = [
        `<span class="font-mono">EIN ${escapeHtml(formatEin(org.ein))}</span>`,
        location ? `<span>${location}</span>` : '',
      ].filter(Boolean).join('<span class="text-gray-300">·</span>');

      const rightCol = (revenue || filingCount > 0) ? `
        <div class="text-right text-sm shrink-0 whitespace-nowrap">
          ${revenue ? `<div class="font-semibold text-gray-800 num">${revenue}</div>` : ''}
          ${filingCount > 0 ? `<div class="text-xs text-gray-400">${filingCount} filing${filingCount === 1 ? '' : 's'}</div>` : ''}
        </div>
      ` : '';

      return `
        <a
          href="/${escapeHtml(org.ein)}/${slugify(org.canonical_name)}"
          data-result-index="${index}"
          class="block border border-gray-200 rounded-xl p-4 hover:border-blue-300 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-150 group"
        >
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0 flex-1">
              <div class="font-semibold text-blue-700 group-hover:text-blue-900 transition-colors truncate">${escapeHtml(org.canonical_name)}</div>
              <div class="text-sm text-gray-500 mt-1 flex flex-wrap items-center gap-x-2 gap-y-1">
                ${meta}
                ${categoryBadge ? `<span class="text-gray-300 hidden sm:inline">·</span>${categoryBadge}` : ''}
              </div>
            </div>
            ${rightCol}
          </div>
        </a>
      `;
    }

    function renderNoResults(query) {
      const looksLikeEin = isEinQuery(query);
      const einHint = looksLikeEin
        ? 'Double-check the 9-digit EIN — leading zeros count.'
        : 'Try the EIN format <span class="font-mono">XX-XXXXXXX</span> if you have it.';

      resultsEl.innerHTML = `
        <div class="rounded-xl bg-gray-50 border border-gray-200 p-6 text-sm text-gray-600 space-y-3">
          <p>No results for <span class="font-medium text-gray-900">"${escapeHtml(query)}"</span>.</p>
          <ul class="list-disc list-inside space-y-1">
            <li>${einHint}</li>
            <li>Search for any part of the name (e.g. "habitat" instead of "Habitat for Humanity International").</li>
            <li>Browse <a class="text-blue-700 hover:underline" href="/states">all states</a> or <a class="text-blue-700 hover:underline" href="/category/education">a category</a>.</li>
          </ul>
        </div>
      `;
    }

    function renderResults(query, fullResults) {
      lastFullResults = fullResults;

      const hasQuery = !!query;
      popularWrap.hidden = hasQuery;
      einBadge.hidden = !isEinQuery(query);
      input.classList.toggle('pr-32', isEinQuery(query));
      input.classList.toggle('pr-4', !isEinQuery(query));

      if (!hasQuery) {
        status.className = 'text-center py-12 text-gray-500';
        status.innerHTML = '<p class="text-lg">Enter an organization name or EIN to search.</p>';
        resultsEl.innerHTML = '';
        showMoreWrap.hidden = true;
        return;
      }

      if (fullResults.length === 0) {
        status.className = 'text-gray-500 mb-4';
        status.innerHTML = `0 results for "${escapeHtml(query)}"`;
        renderNoResults(query);
        showMoreWrap.hidden = true;
        return;
      }

      const displayed = fullResults.slice(0, displayCount);
      status.className = 'text-gray-500 mb-4';
      if (fullResults.length > displayCount) {
        status.innerHTML = `Showing ${displayed.length} of ${fullResults.length} results for "${escapeHtml(query)}"`;
      } else {
        status.innerHTML = `${fullResults.length} result${fullResults.length === 1 ? '' : 's'} for "${escapeHtml(query)}"`;
      }

      resultsEl.innerHTML = displayed.map((org, i) => renderCard(org, i)).join('');

      const remaining = fullResults.length - displayCount;
      if (remaining > 0) {
        showMoreWrap.hidden = false;
        showMoreBtn.textContent = `Show next ${Math.min(PAGE_SIZE, remaining)}`;
      } else {
        showMoreWrap.hidden = true;
      }
    }

    async function runSearch(query, updateUrl = true) {
      const trimmed = (query || '').trim();
      if (updateUrl) {
        const url = trimmed ? `/search?q=${encodeURIComponent(trimmed)}` : '/search';
        history.pushState(null, '', url);
      }
      displayCount = PAGE_SIZE;

      if (!trimmed) {
        renderResults('', []);
        return;
      }

      try {
        const rows = await loadSearchIndex();
        renderResults(trimmed, searchRows(rows, trimmed, stateSelect.value));
      } catch (error) {
        status.className = 'text-gray-500 mb-4';
        status.textContent = 'Search is temporarily unavailable. Please try again later.';
        resultsEl.innerHTML = '';
        showMoreWrap.hidden = true;
        console.error(error);
      }
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      clearTimeout(debounceTimer);
      runSearch(input.value);
    });

    input?.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => runSearch(input.value), 200);
    });

    stateSelect?.addEventListener('change', () => {
      clearTimeout(debounceTimer);
      runSearch(input.value);
    });

    showMoreBtn?.addEventListener('click', () => {
      displayCount += PAGE_SIZE;
      renderResults(input.value.trim(), lastFullResults);
    });

    popularWrap.querySelectorAll('.popular-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const term = btn.dataset.q || '';
        input.value = term;
        clearTimeout(debounceTimer);
        runSearch(term);
        input.focus();
      });
    });

    function focusResult(index) {
      const links = resultsEl.querySelectorAll('a[data-result-index]');
      if (links.length === 0) return;
      const clamped = Math.max(0, Math.min(index, links.length - 1));
      links[clamped].focus();
    }

    input?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        const links = resultsEl.querySelectorAll('a[data-result-index]');
        if (links.length > 0) {
          event.preventDefault();
          focusResult(0);
        }
      } else if (event.key === 'Escape') {
        if (input.value) {
          event.preventDefault();
          input.value = '';
          clearTimeout(debounceTimer);
          runSearch('');
        }
      }
    });

    resultsEl?.addEventListener('keydown', (event) => {
      const links = resultsEl.querySelectorAll('a[data-result-index]');
      if (links.length === 0) return;
      const current = document.activeElement;
      const idx = Array.from(links).indexOf(current);
      if (idx === -1) return;

      if (event.key === 'ArrowDown') {
        event.preventDefault();
        focusResult(idx + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (idx === 0) {
          input.focus();
        } else {
          focusResult(idx - 1);
        }
      } else if (event.key === 'Escape') {
        event.preventDefault();
        input.value = '';
        clearTimeout(debounceTimer);
        runSearch('');
        input.focus();
      }
    });

    window.addEventListener('popstate', () => {
      const q = new URL(window.location.href).searchParams.get('q') || '';
      if (input) input.value = q;
      runSearch(q, false);
    });

    const initialQuery = new URL(window.location.href).searchParams.get('q') || '';
    if (initialQuery) {
      runSearch(initialQuery, false);
    }
  </script>
</BaseLayout>
