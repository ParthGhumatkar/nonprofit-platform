--- 
import BaseLayout from '../layouts/BaseLayout.astro'; 
import { getStats } from '../lib/db'; 
 
const stats = await getStats(); 
--- 
 
<BaseLayout 
  title="Nonprofit Explorer - Philanthropy.org" 
  description="Search IRS Form 990 filings for over 600,000 U.S. nonprofits. View financial data, mission statements, program areas, and grants." 
> 
  <div class="text-center py-12"> 
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Nonprofit Explorer</h1> 
    <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto"> 
      Search IRS Form 990 filings for over {stats.organizations.toLocaleString()} U.S. nonprofits. 
      View financial data, mission statements, program areas, and grants. 
    </p> 
 
    <form class="flex gap-2 max-w-xl mx-auto mb-12" method="get" action="/search"> 
      <input 
        type="text" 
        name="q" 
        placeholder="Organization name or EIN..." 
        class="flex-1 border border-gray-300 rounded-lg px-4 py-3 text-lg focus:outline-none focus:ring-2 focus:ring-blue-500" 
      /> 
      <button 
        type="submit" 
        class="bg-blue-600 text-white px-8 py-3 rounded-lg font-medium hover:bg-blue-700 transition-colors" 
      > 
        Search 
      </button> 
    </form> 
 
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-3xl mx-auto mb-12"> 
      <div class="bg-gray-50 rounded-lg p-6"> 
        <div class="text-3xl font-bold text-blue-700">{stats.organizations.toLocaleString()}</div> 
        <div class="text-gray-500 mt-1">Organizations</div> 
      </div> 
      <div class="bg-gray-50 rounded-lg p-6"> 
        <div class="text-3xl font-bold text-blue-700">{stats.filings.toLocaleString()}</div> 
        <div class="text-gray-500 mt-1">Filings</div> 
      </div> 
      <div class="bg-gray-50 rounded-lg p-6"> 
        <div class="text-3xl font-bold text-blue-700">Free</div> 
        <div class="text-gray-500 mt-1">Public Data</div> 
      </div> 
    </div> 
 
    <div class="flex flex-wrap justify-center gap-4"> 
      <a href="/states" class="border border-gray-300 rounded-lg px-6 py-3 font-medium hover:border-blue-300 hover:text-blue-600 transition-colors"> 
        Browse by State 
      </a> 
      <a href="/search" class="border border-gray-300 rounded-lg px-6 py-3 font-medium hover:border-blue-300 hover:text-blue-600 transition-colors"> 
        Search All Nonprofits 
      </a> 
    </div> 
  </div> 
</BaseLayout>
