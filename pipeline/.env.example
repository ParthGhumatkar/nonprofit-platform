# ─────────────────────────────────────────────────────────────
# pipeline/.env.example
# Copy this file to pipeline/.env and fill in the values.
# pipeline/.env is gitignored and must never be committed.
# When running inside Docker, these variables are set in docker-compose.yml
# and you do not need a .env file.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Required by pipeline/db.py — the module raises RuntimeError on startup if missing.
# Required.
# How to get the value:
#   Local Docker (connecting from outside the container): use the value below.
#   Inside Docker pipeline service: use @db:5432 (see docker-compose.yml).
#   Production: use your hosted Postgres URL.
DATABASE_URL=postgresql://nonprofit:YOUR_PASSWORD@localhost:5433/nonprofit_platform

# Directory where IRS XML filings are stored after download.
# Expected structure: {RAW_XML_DIR}/{EIN}/{YEAR}/{object_id}_public.xml
# pipeline/sync.py walks this directory recursively.
# Optional. Defaults to ./data/raw_xml (relative to the working directory).
# How to get the value: set to the absolute path of your data/raw_xml folder.
RAW_XML_DIR=./data/raw_xml

# Directory where the NCCS BMF CSV file is stored.
# pipeline/bmf_loader.py looks for bmf_extract.csv inside this directory.
# Optional. Defaults to ./data/bmf
# How to get the value: set to the absolute path of your data/bmf folder.
BMF_DIR=./data/bmf

# Override the NCCS BMF download URL.
# bmf_loader.py uses this URL when bmf_extract.csv is not present locally.
# Optional. Defaults to the December 2025 BMF on the NCCS S3 bucket.
# How to get the value: browse https://nccsdata.s3.us-east-1.amazonaws.com/raw/bmf/
#   and pick the most recent YYYY-MM-BMF.csv filename.
NCCS_BMF_URL=https://nccsdata.s3.us-east-1.amazonaws.com/raw/bmf/2025-12-BMF.csv

# Root project directory.
# Used by build_manifest.py and download_xml.py to resolve data/ paths.
# Optional. Defaults to the parent directory of the pipeline/ folder (auto-detected
# via os.path.dirname(__file__)).
# How to get the value: set to the absolute path of the repo root, e.g.:
#   Windows: C:\Users\you\nonprofit-platform
#   Mac/Linux: /home/you/nonprofit-platform
# PROJECT_DIR=C:\Users\you\nonprofit-platform

# Absolute path to the IRS master index parquet file.
# Used by build_manifest.py to select which organisations to include.
# Optional. Defaults to {PROJECT_DIR}/data/indexes/master_index.parquet
# How to get the value: download from the GivingTuesday data lake (see README step 5).
# MASTER_INDEX=C:\Users\you\nonprofit-platform\data\indexes\master_index.parquet

# Number of organisations to include in the download manifest.
# build_manifest.py selects this many organisations ranked by highest revenue.
# Optional. Defaults to 25000.
TARGET_ORGS=25000

# Number of parallel HTTP workers used by download_xml.py.
# Higher values speed up downloads but may hit rate limits or network caps.
# Optional. Defaults to 10.
DOWNLOAD_WORKERS=10
